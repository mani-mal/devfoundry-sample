{
  "name": "devfoundry-vscode",
  "displayName": "DevFoundry",
  "description": "Thin client for the customer DevFoundry API: connect, delegate tasks, search authorized context and review task diffs",
  "version": "0.1.0",
  "publisher": "mani-mal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:devfoundry.connect"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devfoundry.connect",
        "title": "Connect to DevFoundry",
        "category": "DevFoundry"
      },
      {
        "command": "devfoundry.createWorkspace",
        "title": "Create Workspace",
        "category": "DevFoundry"
      },
      {
        "command": "devfoundry.runTask",
        "title": "Delegate a Task",
        "category": "DevFoundry"
      },
      {
        "command": "devfoundry.cancelTask",
        "title": "Cancel Task",
        "category": "DevFoundry"
      },
      {
        "command": "devfoundry.retryTask",
        "title": "Retry Task",
        "category": "DevFoundry"
      },
      {
        "command": "devfoundry.searchContext",
        "title": "Search Authorized Context",
        "category": "DevFoundry"
      },
      {
        "command": "devfoundry.reviewDiff",
        "title": "Review Task Diff",
        "category": "DevFoundry"
      },
      {
        "command": "devfoundry.openConsole",
        "title": "Open Web Console",
        "category": "DevFoundry"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devfoundry",
          "title": "DevFoundry",
          "icon": "media/devfoundry.svg"
        }
      ]
    },
    "views": {
      "devfoundry": [
        {
          "id": "devfoundry.tasks",
          "name": "Tasks"
        },
        {
          "id": "devfoundry.workspace",
          "name": "Workspace"
        }
      ]
    },
    "configuration": {
      "title": "DevFoundry",
      "properties": {
        "devfoundry.url": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "DevFoundry API base URL for this installation"
        },
        "devfoundry.projectId": {
          "type": "string",
          "default": "",
          "description": "Project ID (UUID) used when submitting tasks; prompted and saved on first delegation if unset"
        },
        "devfoundry.userId": {
          "type": "string",
          "default": "",
          "description": "Requesting user ID (UUID) used when submitting tasks; prompted and saved on first delegation if unset"
        },
        "devfoundry.consoleUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "DevFoundry web console URL opened by the Open Web Console command"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "1.85.0"
  }
}
