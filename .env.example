# DevFoundry Compact Profile Environment Configuration

# Database Configuration
POSTGRES_PASSWORD=devfoundry
DATABASE_URL=postgres://devfoundry:devfoundry@postgres:5432/devfoundry

# RouteForge Gateway Configuration
ROUTEFORGE_URL=http://routeforge:8080

# ContextForge MCP Gateway Configuration
CONTEXTFORGE_URL=http://context-forge:3001

# Langfuse Configuration
LANGFUSE_URL=http://langfuse:3000
NEXTAUTH_SECRET=langfuse-secret
SALT=langfuse-salt

# Worker Configuration
WORKER_ID=worker-1

# Logging
LOG_LEVEL=info

# Evidence Storage
EVIDENCE_STORAGE_PATH=/var/data/evidence
EVIDENCE_RETENTION_DAYS=30
