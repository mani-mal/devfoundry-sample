# nginx reverse proxy for DevFoundry Worker
FROM nginx:alpine

COPY <<'NGINX_CONF' /etc/nginx/conf.d/default.conf
server {
    listen 3002;
    
    location /health {
        return 200 '{"status":"healthy","timestamp":"$time_iso8601"}';
        add_header Content-Type application/json;
    }
    
    location / {
        return 200 '{"name":"DevFoundry Worker","version":"0.1.0","description":"Background task worker","timestamp":"$time_iso8601"}';
        add_header Content-Type application/json;
    }
}
NGINX_CONF
