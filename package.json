{
  "name": "dev-foundry",
  "version": "0.1.0",
  "description": "DevFoundry: on-premises software factory",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/api",
    "packages/worker",
    "packages/cli",
    "packages/integrations/routeforge",
    "packages/integrations/opencode",
    "packages/integrations/context-forge"
  ],
  "scripts": {
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "lint": "nx run-many --target=lint",
    "dev": "nx watch --project=api"
  },
  "devDependencies": {
    "nx": "^19.0.0",
    "@nx/devkit": "^19.0.0",
    "typescript": "^5.5.0"
  }
}
