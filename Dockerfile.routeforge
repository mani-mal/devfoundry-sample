# nginx reverse proxy for RouteForge
FROM nginx:alpine

COPY <<'NGINX_CONF' /etc/nginx/conf.d/default.conf
server {
    listen 8000;
    
    location /health {
        return 200 '{"status":"healthy","timestamp":"$time_iso8601"}';
        add_header Content-Type application/json;
    }
    
    location / {
        return 200 '{"name":"DevFoundry RouteForge","version":"0.1.0","description":"Model Gateway","timestamp":"$time_iso8601"}';
        add_header Content-Type application/json;
    }
}
NGINX_CONF
